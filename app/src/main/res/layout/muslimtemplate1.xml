<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#8B0000">

    <LinearLayout
        android:id="@+id/preview_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="8dp"
        android:padding="12dp"
        android:background="@drawable/border_maroon"
        >

        <!-- Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingBottom="8dp"
            android:background="@drawable/headerbackgroundred"
            >

            <!-- Islamic Symbol -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☪"
                android:textSize="32sp"
                android:textColor="@color/white"
                android:layout_marginBottom="4dp" />

            <!-- Bismillah -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيْمِ"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_marginBottom="2dp" />

            <!-- Translation -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="In the name of Allah, The Most Merciful"
                android:textSize="10sp"
                android:textStyle="italic"
                android:textColor="@color/white"
                android:letterSpacing="0.05"
                android:layout_marginBottom="2dp" />

        </LinearLayout>

        <!-- Profile Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp">

            <!-- Profile Photo -->
            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/border_maroon"
                android:padding="3dp"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:id="@+id/preview_photo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Profile Photo"
                     />
            </FrameLayout>

            <!-- Name and Basic Info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/preview_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#8B0000"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/preview_age"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#8B0000" />

                <TextView
                    android:id="@+id/preview_gender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#8B0000" />

            </LinearLayout>

        </LinearLayout>

        <!-- Personal Information Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PERSONAL DETAILS"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:background="@drawable/selection_title_red"
            android:padding="6dp"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0.05" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="12dp">

            <!-- Left Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <!-- Religion -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Religion"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#8B0000" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" : "
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#8B0000" />

                    <TextView
                        android:id="@+id/preview_religion"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.5"
                        android:textSize="10sp"
                        android:textColor="#8B0000" />

                </LinearLayout>

                <!-- Profession -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Profession"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#8B0000" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" : "
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#8B0000" />

                    <TextView
                        android:id="@+id/preview_profession"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.5"
                        android:textSize="10sp"
                        android:textColor="#8B0000" />

                </LinearLayout>

            </LinearLayout>

            <!-- Right Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <!-- Education -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Education"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#8B0000" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" : "
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#8B0000" />

                    <TextView
                        android:id="@+id/preview_qualification"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.5"
                        android:textSize="10sp"
                        android:textColor="#8B0000" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Family Details Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FAMILY DETAILS"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:background="@drawable/selection_title_red"
            android:padding="6dp"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0.05" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="12dp">

            <!-- Left Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <!-- Father Name -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Father"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#8B0000" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" : "
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#8B0000" />

                    <TextView
                        android:id="@+id/preview_father_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.5"
                        android:textSize="10sp"
                        android:textColor="#8B0000" />

                </LinearLayout>

                <!-- Father Occupation -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="F.Occ"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#8B0000" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" : "
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#8B0000" />

                    <TextView
                        android:id="@+id/preview_father_occupation"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.5"
                        android:textSize="10sp"
                        android:textColor="#8B0000" />

                </LinearLayout>

                <!-- Mother Name -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Mother"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#8B0000" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" : "
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#8B0000" />

                    <TextView
                        android:id="@+id/preview_mother_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.5"
                        android:textSize="10sp"
                        android:textColor="#8B0000" />

                </LinearLayout>

            </LinearLayout>

            <!-- Right Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <!-- Mother Occupation -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="M.Occ"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#8B0000" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" : "
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#8B0000" />

                    <TextView
                        android:id="@+id/preview_mother_occupation"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.5"
                        android:textSize="10sp"
                        android:textColor="#8B0000" />

                </LinearLayout>

                <!-- Brothers -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Brothers"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#8B0000" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" : "
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#8B0000" />

                    <TextView
                        android:id="@+id/preview_brothers"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.5"
                        android:textSize="10sp"
                        android:textColor="#8B0000" />

                </LinearLayout>

                <!-- Sisters -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Sisters"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#8B0000" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" : "
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#8B0000" />

                    <TextView
                        android:id="@+id/preview_sisters"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.5"
                        android:textSize="10sp"
                        android:textColor="#8B0000" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Contact Details Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CONTACT DETAILS"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:background="@drawable/selection_title_red"
            android:padding="6dp"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0.05" />

        <!-- Contact -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contact"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#8B0000"
                android:minWidth="80dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" : "
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#8B0000" />

            <TextView
                android:id="@+id/preview_contact"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="10sp"
                android:textColor="#8B0000" />

        </LinearLayout>

        <!-- Address -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Address"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#8B0000"
                android:minWidth="80dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" : "
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#8B0000" />

            <TextView
                android:id="@+id/preview_address"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="10sp"
                android:textColor="#8B0000"
                android:maxLines="2" />

        </LinearLayout>

        <!-- Hobbies -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hobbies"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#8B4513"
                android:minWidth="80dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" : "
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#8B4513" />

            <TextView
                android:id="@+id/preview_hobbies"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="10sp"
                android:textColor="#8B0000"
                android:maxLines="2" />

        </LinearLayout>

        <!-- Additional Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Additional"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#8B0000"
                android:minWidth="80dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" : "
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#8B0000" />

            <TextView
                android:id="@+id/preview_additional_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="10sp"
                android:textColor="#8B0000"
                android:maxLines="2" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>